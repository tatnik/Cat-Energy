{
  "name": "cat_energy",
  "private": true,
  "description": "Личный проект от HTML Academy",
  "devDependencies": {
    "@htmlacademy/editorconfig-cli": "1.0.0",
    "autoprefixer": "10.2.5",
    "browser-sync": "^2.29.3",
    "browser-sync-client": "^2.27.9",
    "del": "^6.0.0",
    "gulp": "^4.0.2",
    "gulp-htmlmin": "^5.0.1",
    "gulp-imagemin": "^7.1.0",
    "gulp-plumber": "1.2.1",
    "gulp-postcss": "9.0.0",
    "gulp-rename": "^2.0.0",
    "gulp-sass": "^6.0.1",
    "gulp-sourcemaps": "3.0.0",
    "gulp-svgstore": "^9.0.0",
    "gulp-terser": "^2.1.0",
    "gulp-webp": "^4.0.1",
    "postcss": "^8.4.24",
    "prettier": "^2.8.8",
    "sass": "^1.89.2",
    "stylelint": "^16.22.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "stylelint-scss": "^6.12.1"
  },
  "scripts": {
    "editorconfig": "editorconfig-cli",
    "stylelint": "stylelint \"source/sass/**/*.scss\" ",
    "fix:stylelint": "stylelint \"source/sass/**/*.scss\" --fix",
    "test": "npm run editorconfig && npm run stylelint",
    "lint:prettier": "prettier --check \"source/**/*.{html,json,css,scss,md}\"",
    "fix:lint:prettier": "prettier --write \"source/**/*.{html,json,css,scss,md}\"",
    "build": "gulp styles",
    "start": "gulp",
    "deploy:docs": "rm -rf docs && cp -r build docs"
  },
  "browserslist": [
    "last 2 versions",
    "not dead",
    "not ie <= 11"
  ],
  "editorconfig-cli": [
    "*.json",
    "*.js",
    "source/*.html",
    "source/js/**/*.js",
    "source/img/**/*.svg",
    "source/sass/**/*.scss"
  ],
  "engines": {
    "node": "^12 || ^14 || ^18 "
  },
  "dependencies": {
    "eslint": "^8.41.0"
  }
}
